  "statistics": {"bootstrap_resamples": 10000, "ci": 0.95, "paired_by": "scenario seed (common random numbers)",
                 "categories": ["STATISTICALLY_DISTINGUISHABLE", "PRACTICALLY_MEANINGFUL", "INCONCLUSIVE"],
