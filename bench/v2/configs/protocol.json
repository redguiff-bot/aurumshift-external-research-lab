          "ucb_mean": {"delta": [0.1, 0.5, 1.0]}},
    "C2_guard_on_top3_C": {"S": [25, 50, 100], "M": [1, 4, 16]},
    "D": {"squarecb": {"gamma_scale": [5, 20, 100], "lr": [0.01, 0.05, 0.2], "use_group": [true, false]},
          "eps": {"eps": [0.05, 0.2], "lr": [0.01, 0.05, 0.2], "use_group": [true, false]}}
